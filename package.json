{
  "name": "hive",
  "version": "0.0.1",
  "private": true,
  "description": "Local multi-agent harness: one UI, any ACP agent, agents that talk to each other",
  "type": "module",
  "bin": {
    "hive": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "hive-mcp": "tsx src/hive/server.ts",
    "test": "tsx test/e2e.ts && tsx test/session.ts && tsx test/scheduler.ts && tsx test/unit.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.5.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "better-sqlite3": "^12.0.0",
    "chokidar": "^4.0.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
